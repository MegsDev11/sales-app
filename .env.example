NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_your-key
SUPABASE_SERVICE_ROLE_KEY=sb_secret_your-key
# One-time owner bootstrap (POST /api/admin/bootstrap), then remove OWNER_PASSWORD
OWNER_EMAIL=owner@yourcompany.co.za
OWNER_PASSWORD=change-me-after-bootstrap
OWNER_NAME=Megs Owner
# Legacy admin bootstrap vars (optional fallback)
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=
# Optional — only needed for npm run db:migrate
DATABASE_URL=postgresql://postgres.[ref]:[password]@aws-0-eu-west-1.pooler.supabase.com:6543/postgres
# Optional — Ruijie / Reyee Cloud (apply via service_rj@ruijienetworks.com)
RUIJIE_APP_ID=
RUIJIE_APP_SECRET=
# RUIJIE_CLOUD_BASE_URL=https://cloud.ruijienetworks.com

# --- Claude (website assistant + project advisor) ---
# One key serves both. Get it from platform.claude.com -> API keys, and add credits:
# API usage is prepaid and separate from any claude.ai subscription.
# Without it the chat widget hides itself, /api/chat returns 503, and the project
# advisor shows "not switched on" instead of a dead button.
ANTHROPIC_API_KEY=
# Escalations are emailed here. Unset means they are still logged, just not announced.
SUPPORT_ONCALL_EMAIL=
# Cost/latency dial: low | medium | high | xhigh | max. Defaults to medium.
# SUPPORT_CHAT_EFFORT=medium
# The project advisor reasons across the whole delivery history and is asked for a
# considered answer once in a while, not a chat turn — so it defaults to `high`
# rather than medium. Lower it if advice feels slow; raise it if it starts making
# claims the record does not support.
# PROJECT_ADVISOR_EFFORT=high

# --- Scheduled jobs ---
# Shared secret for the HTTP cron entry points (/api/cron/*). Only needed when
# the daily overdue sweep runs via an external scheduler (Vercel cron, GitHub
# Actions) instead of pg_cron inside Supabase — migration 064 explains both.
CRON_SECRET=

# --- Outgoing mail (accounts invoices, chat verification codes, escalations) ---
# ACCOUNTS_SMTP_PASS must be an APP PASSWORD — Microsoft and Google refuse basic auth.
ACCOUNTS_SMTP_HOST=
ACCOUNTS_SMTP_USER=
ACCOUNTS_SMTP_PASS=
# ACCOUNTS_SMTP_PORT=587
# ACCOUNTS_SMTP_FROM=
# ACCOUNTS_SMTP_SECURE=false
